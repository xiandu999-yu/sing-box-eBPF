+func normalizeDelivery(value string) (string, error) {
+	switch value {
+	case "", deliveryVeth:
+		return deliveryVeth, nil
+	case deliveryNetkit, deliveryNetkitL3, deliveryAuto:
+		return value, nil
+	default:
+		return "", E.New("unknown eBPF delivery: ", value)
+	}
+}
+
+// resolveTCXOrder merges the per-scope TCX order. Both scopes share the same
+// attachments backend, so explicit values must agree.
+func resolveTCXOrder(options option.EBPFInboundOptions) (uint16, string, error) {
+	for scope, position := range map[string]string{
+		"local":  options.Local.TCXPosition,
+		"shared": options.Shared.TCXPosition,
+	} {
+		switch position {
+		case "", "head", "tail":
+		default:
+			return 0, "", E.New(scope, ".tcx_position must be head or tail: ", position)
+		}
+	}
+	if options.Local.TCXPriority != 0 && options.Shared.TCXPriority != 0 &&
+		options.Local.TCXPriority != options.Shared.TCXPriority {
+		return 0, "", E.New("local.tcx_priority (", options.Local.TCXPriority,
+			") and shared.tcx_priority (", options.Shared.TCXPriority, ") differ")
+	}
+	if options.Local.TCXPosition != "" && options.Shared.TCXPosition != "" &&
+		options.Local.TCXPosition != options.Shared.TCXPosition {
+		return 0, "", E.New("local.tcx_position (", options.Local.TCXPosition,
+			") and shared.tcx_position (", options.Shared.TCXPosition, ") differ")
+	}
+	priority := uint16(options.Local.TCXPriority)
+	if priority == 0 {
+		priority = uint16(options.Shared.TCXPriority)
+	}
+	// 0 表示没显式指定优先级，由 tcx_position 决定锚点；不要在这里兜底成 1，
+	// 否则 runtime 会一直走优先级排序，链首/链尾永远不生效。
+	position := options.Local.TCXPosition
+	if position == "" {
+		position = options.Shared.TCXPosition
+	}
+	if position == "" {
+		position = "head"
+	}
+	return priority, position, nil
+}
