+// ProcessMarkerConfig configures the slimmed process-bypass markers: a copy of
+// the cgroup backend reduced to dae's split, where the cgroup layer only
+// identifies the process and flags the socket, and every packet stays with TC.
+type ProcessMarkerConfig struct {
+	Path          string
+	BypassProcess []string
+	SelfBypass    *SelfBypass
+}
+
+type ProcessMarkerBackend struct {
+	backend *core.ProcessMarkerBackend
+}
+
+func PrepareProcessMarker(config ProcessMarkerConfig) (*ProcessMarkerBackend, error) {
+	markerConfig := core.ProcessMarkerConfig{
+		Path:          config.Path,
+		BypassProcess: config.BypassProcess,
+	}
+	// The facade embeds the handle, so the socket map is only reachable through
+	// the internal unwrap (the public type exposes no raw maps).
+	if selfBypass := core.UnwrapSelfBypass(config.SelfBypass); selfBypass != nil {
+		markerConfig.SelfBypassMap = selfBypass.Map()
+	}
+	backend, err := core.PrepareProcessMarker(markerConfig)
+	if err != nil {
+		return nil, err
+	}
+	return &ProcessMarkerBackend{backend: backend}, nil
+}
+
+func (b *ProcessMarkerBackend) Close() error {
+	if b == nil || b.backend == nil {
+		return nil
+	}
+	return b.backend.Close()
+}
+
+func (b *ProcessMarkerBackend) IsClosed() bool {
+	return b == nil || b.backend == nil || b.backend.IsClosed()
+}
