+// run as the task that issued the syscall, so bpf_get_current_comm names the
+// program that owns the connection. Matched processes are never proxied.
+INLINE bool process_bypassed(void) {
+    struct sb_ebpf_process_lpm_key key = {.prefixlen = (__u32)sizeof(key.name) * 8U};
