-func attachTCXInterface(linkDevice netlink.Link, backend *commonEBPF.TCBackend, attachment *tcInterfaceAttachment, priority uint16) (bool, error) {
-	closeLinks := func(err error) (bool, error) {
-		return false, E.Errors(err, attachment.closeLinks())
-	}
-	icmpEchoReplyEnabled := backend.ICMPEchoReplyEnabled()
-	pairs := []struct {
-		enabled     bool
-		role        string
-		attachType  CiliumEBPF.AttachType
-		program     *CiliumEBPF.Program
-		icmpProgram *CiliumEBPF.Program
-		mainLink    *link.Link
-		icmpLink    *tcxAttachedLink
-	}{
-		{attachment.role.local, "local", CiliumEBPF.AttachTCXEgress,
-			rawTCBackend(backend).LocalEgressProgram(attachment.framing), rawTCBackend(backend).ICMPEchoLocalReplyProgram(attachment.framing),
-			&attachment.localLink, &attachment.localICMPLink},
-		{attachment.role.shared, "shared", CiliumEBPF.AttachTCXIngress,
-			rawTCBackend(backend).SharedIngressProgram(attachment.framing), rawTCBackend(backend).ICMPEchoSharedReplyProgram(attachment.framing),
-			&attachment.sharedLink, &attachment.sharedICMPLink},
-	}
