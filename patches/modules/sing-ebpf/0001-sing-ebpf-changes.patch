+// mark_socket_bypass flags the socket for the TC side. The cgroup data plane
+// returns 1 by itself, but socket_assign is decided in TC, where the calling
+// process is invisible, so the decision has to travel as socket metadata.
+INLINE void mark_socket_bypass(__u64 cookie) {
