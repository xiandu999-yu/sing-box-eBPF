diff --git a/internal/core/marker.go b/internal/core/marker.go
new file mode 100644
index 0000000..14bc1f6
--- /dev/null
+++ b/internal/core/marker.go
@@ -0,0 +1,151 @@
+//go:build with_ebpf && (linux || android)
+
+package core
+
+import (
+	CiliumEBPF "github.com/cilium/ebpf"
+	E "github.com/sagernet/sing/common/exceptions"
+	"golang.org/x/sys/unix"
+)
+
+// ProcessMarkerConfig configures the minimal process-bypass markers.
+type ProcessMarkerConfig struct {
+	// Path is the cgroup v2 directory to attach to; empty means the detected
+	// hierarchy root.
+	Path string
+	// BypassProcess lists process-name prefixes that must never be proxied.
+	BypassProcess []string
+	// SelfBypassMap is the socket metadata map shared with the TC data plane.
+	SelfBypassMap *CiliumEBPF.Map
+}
+
+// ProcessMarkerBackend attaches the four cgroup hooks that flag process-bypassed
+// sockets for the TC data plane. It deliberately owns no redirect state, no
+// listener port and no UDP cleanup machinery: it is the cgroup counterpart of
+// a filter that only tags sockets.
+type ProcessMarkerBackend struct {
+	collection *CiliumEBPF.Collection
+	links      []cgroupProgramLink
+	process    *CiliumEBPF.Map
+}
+
+var processMarkerSections = []struct {
+	name       string
+	attachType CiliumEBPF.AttachType
+}{
+	{"sb_marker_conn4", CiliumEBPF.AttachCGroupInet4Connect},
+	{"sb_marker_conn6", CiliumEBPF.AttachCGroupInet6Connect},
+	{"sb_marker_send4", CiliumEBPF.AttachCGroupUDP4Sendmsg},
+	{"sb_marker_send6", CiliumEBPF.AttachCGroupUDP6Sendmsg},
+}
+
+const (
+	processMarkerLPM = "cgroup_process_bypass"
+	processMarkerSockets = "cgroup_socket_bypass"
+)
+
+// PrepareProcessMarker loads only the marker programs and their two maps from the
+// cgroup object and attaches them.
+func PrepareProcessMarker(config ProcessMarkerConfig) (*ProcessMarkerBackend, error) {
+	if config.SelfBypassMap == nil {
+		return nil, E.New("missing eBPF self-bypass map")
+	}
+	path := config.Path
+	if path == "" {
+		var err error
+		path, err = DetectCgroup2Root()
+		if err != nil {
+			return nil, err
+		}
+	}
+	if err := validateCgroup2Mount("cgroup", path); err != nil {
+		return nil, err
+	}
+	spec, err := loadCgroup()
+	if err != nil {
+		return nil, err
+	}
+	wanted := make(map[string]struct{}, len(processMarkerSections))
+	for _, section := range processMarkerSections {
+		wanted[section.name] = struct{}{}
+	}
+	for name := range spec.Programs {
+		if _, ok := wanted[name]; !ok {
+			delete(spec.Programs, name)
+		}
+	}
+	for name := range spec.Maps {
+		if name != processMarkerLPM && name != processMarkerSockets {
+			delete(spec.Maps, name)
+		}
+	}
+	processSpec, ok := spec.Maps[processMarkerLPM]
+	if !ok {
+		return nil, E.New("eBPF marker object is missing the process bypass map")
+	}
+	processSpec.MaxEntries = maxProcessBypassEntries
+	processSpec.Flags |= unix.BPF_F_NO_PREALLOC
+	if _, ok = spec.Maps[processMarkerSockets]; !ok {
+		return nil, E.New("eBPF marker object is missing the socket bypass map")
+	}
+	// The object declares the shared map with a placeholder capacity; the replacement
+	// must match the real map or the loader rejects it.
+	socketsSpec := spec.Maps[processMarkerSockets]
+	socketsSpec.Type = CiliumEBPF.LRUHash
+	socketsSpec.MaxEntries = config.SelfBypassMap.MaxEntries()
+	socketsSpec.Flags = 0
+	collection, err := CiliumEBPF.NewCollectionWithOptions(spec, CiliumEBPF.CollectionOptions{
+		MapReplacements: map[string]*CiliumEBPF.Map{processMarkerSockets: config.SelfBypassMap},
+	})
+	if err != nil {
+		return nil, eBPFOperationError("load eBPF process markers", err)
+	}
+	// The replaced map belongs to the caller: dropping it from the collection
+	// keeps Close from closing the self-bypass map the TC side still uses.
+	delete(collection.Maps, processMarkerSockets)
+	backend := &ProcessMarkerBackend{collection: collection, process: collection.Maps[processMarkerLPM]}
+	if err = populateProcessBypass(backend.process, config.BypassProcess); err != nil {
+		collection.Close()
+		return nil, err
+	}
+	for _, section := range processMarkerSections {
+		program := collection.Programs[section.name]
+		if program == nil {
+			backend.Close()
+			return nil, E.New("eBPF marker object is missing program ", section.name)
+		}
+		// Shared-only: a legacy single-program hook would have to displace the
+		// data plane program, which is never acceptable for an optional feature.
+		programLink, linkErr := attachCgroupProgramShared(path, program, section.attachType)
+		if linkErr != nil {
+			backend.Close()
+			return nil, eBPFOperationError("attach eBPF process marker "+section.name, linkErr)
+		}
+		backend.links = append(backend.links, programLink)
+	}
+	return backend, nil
+}
+
+// Close detaches every marker hook. The shared socket map is left alone.
+func (b *ProcessMarkerBackend) Close() error {
+	if b == nil {
+		return nil
+	}
+	var closeErr error
+	for _, link := range b.links {
+		closeErr = E.Errors(closeErr, link.Close())
+	}
+	b.links = nil
+	if b.collection != nil {
+		// Collection.Close reports nothing; programs and owned maps are released.
+		b.collection.Close()
+		b.collection = nil
+	}
+	b.process = nil
+	return closeErr
+}
+
+// IsClosed reports whether the markers have been detached.
+func (b *ProcessMarkerBackend) IsClosed() bool {
+	return b == nil || b.collection == nil
+}
diff --git a/internal/core/process_bypass.go b/internal/core/process_bypass.go
new file mode 100644
index 0000000..80d573b
--- /dev/null
+++ b/internal/core/process_bypass.go
@@ -0,0 +1,57 @@
+//go:build with_ebpf && (linux || android)
+
+package core
+
+import (
+	CiliumEBPF "github.com/cilium/ebpf"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// maxProcessBypassEntries bounds the process-name LPM trie. One entry is one
+// configured prefix, so a handful is the normal case; the ceiling only stops a
+// pathological configuration from allocating an oversized map.
+const maxProcessBypassEntries = 256
+
+// maxProcessNameLength is TASK_COMM_LEN-1: bpf_get_current_comm fills 16 bytes
+// and the kernel truncates task->comm to 15 characters plus NUL.
+const maxProcessNameLength = 15
+
+// populateProcessBypass installs process-name prefixes into the LPM trie that
+// the cgroup hooks match against bpf_get_current_comm.
+func populateProcessBypass(processMap *CiliumEBPF.Map, names []string) error {
+	if len(names) == 0 || processMap == nil {
+		return nil
+	}
+	for _, name := range names {
+		entry, err := compileProcessBypassKey(name)
+		if err != nil {
+			return err
+		}
+		if err = processMap.Update(entry, uint8(1), 0); err != nil {
+			return E.Cause(err, "write eBPF bypass_process ", name)
+		}
+	}
+	return nil
+}
+
+// compileProcessBypassKey turns a configured name into an LPM key. The value is
+// a prefix match, so "transmission-da" also covers "transmission-daemon" after
+// the kernel truncated it.
+func compileProcessBypassKey(name string) (processLPMKey, error) {
+	var key processLPMKey
+	if name == "" {
+		return key, E.New("eBPF bypass_process entry is empty")
+	}
+	if len(name) > maxProcessNameLength {
+		return key, E.New("eBPF bypass_process ", name,
+			" is longer than the kernel's 15 byte comm limit; use its truncated form")
+	}
+	for index := 0; index < len(name); index++ {
+		if name[index] < 0x20 || name[index] > 0x7e {
+			return key, E.New("eBPF bypass_process must be printable ASCII: ", name)
+		}
+	}
+	copy(key.Name[:], name)
+	key.PrefixLength = uint32(len(name)) * 8
+	return key, nil
+}
