+//go:build with_ebpf && (linux || android)
+
+package runtime
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"net"
+	"os"
+	"strings"
+
+	CiliumEBPF "github.com/cilium/ebpf"
+
+	commonEBPF "github.com/CHIZI-0618/sing-ebpf"
+	intcore "github.com/CHIZI-0618/sing-ebpf/internal/core"
+	"github.com/sagernet/netlink"
+	E "github.com/sagernet/sing/common/exceptions"
+)
+
+// newTCDeliveryHardwareAddress returns a random locally administered unicast
+// MAC address for one end of the delivery pair.
+//
+// The host end is in the network namespace udevd manages. systemd's
+// 99-default.link (MACAddressPolicy=persistent) replaces a kernel-generated
+// address (NET_ADDR_RANDOM) shortly after the link appears, after the private
+// namespace's static neighbor entry was set to it; an address given at creation
+// is NET_ADDR_SET, which udev leaves alone. The redirect programs address each
+// frame to the private end, which drops a frame for any other MAC as
+// PACKET_OTHERHOST, so that end gets an explicit address as well.
+func newTCDeliveryHardwareAddress() (net.HardwareAddr, error) {
+	address := make(net.HardwareAddr, len(commonEBPF.MACAddress{}))
+	if _, err := rand.Read(address); err != nil {
+		return nil, err
+	}
+	address[0] = address[0]&^0x01 | 0x02
+	return address, nil
+}
+
+func tcDeliveryMACAddress(link netlink.Link) (commonEBPF.MACAddress, bool) {
+	var address commonEBPF.MACAddress
+	hardwareAddress := link.Attrs().HardwareAddr
+	if len(hardwareAddress) != len(address) {
+		return address, false
+	}
+	copy(address[:], hardwareAddress)
+	return address, true
+}
+
+func nextTCVethNames() (string, string, error) {
+	return nextTCDeliveryNames(DeliveryVeth)
+}
+
+// nextTCDeliveryNames allocates the host and peer names of one delivery pair.
+// Linux caps interface names at 15 characters, so "sing-box-veth-<random>"
+// does not fit; the "sb-" prefix keeps the device kind readable within the
+// limit. Only concrete kinds are named: "auto" is resolved into netkit or veth
+// before this runs, so the name always matches what is mounted.
+func nextTCDeliveryNames(kind string) (string, string, error) {
+	prefix := "sb-veth-"
+	suffixLength := 6
+	if kind == DeliveryNetkit || kind == DeliveryNetkitL3 {
+		prefix = "sb-netkit-"
+		suffixLength = 5
+	}
+	for range 1024 {
+		redirectSuffix, err := newTCDeliveryNameSuffix(suffixLength)
+		if err != nil {
+			return "", "", err
+		}
+		deliverySuffix, err := newTCDeliveryNameSuffix(suffixLength)
+		if err != nil {
+			return "", "", err
+		}
+		redirectName := prefix + redirectSuffix
+		deliveryName := prefix + deliverySuffix
+		if redirectName == deliveryName {
+			continue
+		}
+		_, redirectErr := netlink.LinkByName(redirectName)
+		_, deliveryErr := netlink.LinkByName(deliveryName)
+		if tcLinkNotFound(redirectErr) && tcLinkNotFound(deliveryErr) {
+			return redirectName, deliveryName, nil
+		}
+		if redirectErr != nil && !tcLinkNotFound(redirectErr) {
+			return "", "", redirectErr
+		}
+		if deliveryErr != nil && !tcLinkNotFound(deliveryErr) {
+			return "", "", deliveryErr
+		}
+	}
+	return "", "", E.New("unable to allocate TC eBPF delivery link name")
+}
+
+func newTCDeliveryNameSuffix(length int) (string, error) {
+	raw := make([]byte, (length+1)/2)
+	if _, err := rand.Read(raw); err != nil {
+		return "", err
+	}
+	return hex.EncodeToString(raw)[:length], nil
+}
+
+// These settings are applied only inside the caller-owned private namespace.
+// Namespace destruction owns their lifetime; no host-global restore list exists.
+func tcInterfaceSysctlPath(interfaceName, setting string) string {
+	return "/proc/sys/net/ipv4/conf/" + interfaceName + "/" + setting
+}
+
+func setTCSysctl(path, value string) (bool, error) {
+	current, err := os.ReadFile(path)
+	if err != nil {
+		return false, err
+	}
+	if strings.TrimSpace(string(current)) == value {
+		return false, nil
+	}
+	if err = os.WriteFile(path, []byte(value), 0o644); err != nil {
+		return false, err
+	}
+	return true, nil
+}
+
+// attachTCDeliveryHook attaches one delivery hook, preferring TCX and falling
+// back to clsact when TCX is unavailable on this kernel or hook.
+func attachTCDeliveryHook(device netlink.Link, program *CiliumEBPF.Program, programFD int, name string,
+	handle, priority uint16, backend *commonEBPF.TCBackend) (tcxAttachedLink, *netlink.BpfFilter, error) {
+	if program != nil {
+		attached, err := tcxAttach(device.Attrs().Index, CiliumEBPF.AttachTCXIngress, program, backend, priority)
+		if err == nil {
+			return attached, nil, nil
+		}
+		if !tcxUnsupportedError(err) && !errors.Is(err, intcore.ErrTCXOrderUnavailable) {
+			return nil, nil, E.Cause(err, "attach TCX ", name)
+		}
+	}
+	if err := ensureTCClsact(device); err != nil {
+		return nil, nil, err
+	}
+	filter, err := attachTCFilter(device, netlink.HANDLE_MIN_INGRESS, programFD, name, handle, priority)
+	if err != nil {
+		return nil, nil, err
+	}
+	return nil, filter, nil
+}
+
+func deliveryHookAttached(attached tcxAttachedLink, filter *netlink.BpfFilter, device netlink.Link,
+	name string, handle, priority uint16) (bool, error) {
+	if attached != nil {
+		return tcxLinkAttached(attached, device.Attrs().Index, CiliumEBPF.AttachTCXIngress)
+	}
+	return tcFilterAttached(device, netlink.HANDLE_MIN_INGRESS, name, handle, priority)
+}
+
+func closeTCDeliveryHook(attached *tcxAttachedLink, filter **netlink.BpfFilter) error {
+	if *attached != nil {
+		err := (*attached).Close()
+		if err == nil {
+			*attached = nil
+		}
+		return err
+	}
+	return detachTCFilterOwned(filter)
+}
+
+func repairTCDeliveryHook(attached *tcxAttachedLink, filter **netlink.BpfFilter, device netlink.Link,
+	program *CiliumEBPF.Program, programFD int, name string, handle, priority uint16,
+	backend *commonEBPF.TCBackend) (bool, error) {
+	live, err := deliveryHookAttached(*attached, *filter, device, name, handle, priority)
+	if err != nil || live {
+		return false, err
+	}
+	if *attached != nil {
+		_ = (*attached).Close()
+		*attached = nil
+	}
+	newLink, newFilter, err := attachTCDeliveryHook(device, program, programFD, name, handle, priority, backend)
+	if err != nil {
+		return false, err
+	}
+	*attached, *filter = newLink, newFilter
+	return true, nil
+}
+
+func (d *tcDeliveryLink) IsClosed() bool {
+	return d == nil || d.filter == nil && d.returnFilter == nil &&
+		d.deliverLink == nil && d.returnLink == nil && d.redirect == nil && d.delivery == nil
+}
+
+func (d *tcDeliveryLink) Close() error {
+	if d == nil {
+		return nil
+	}
+	return d.closeIsolated()
+}
