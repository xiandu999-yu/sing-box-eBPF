+	"github.com/sagernet/netlink"
+	"github.com/sagernet/netlink/nl"
+	E "github.com/sagernet/sing/common/exceptions"
+	"golang.org/x/sys/unix"
+)
+
+// Delivery link kinds accepted by commonEBPF.TCConfig.Delivery.
+const (
+	DeliveryVeth   = "veth"
+	DeliveryNetkit = "netkit"
+	// DeliveryNetkitL3 is netkit without L2 framing.
+	DeliveryNetkitL3 = "netkit-l3"
+	// DeliveryAuto prefers netkit and falls back to veth when netkit cannot be
+	// created on this kernel.
+	DeliveryAuto = "auto"
+
+	// netkitModeL2 keeps Ethernet framing, which is the default and the only
+	// mode this fork ships. netkitModeL3 drops the MAC/ARP layer but, per the
+	// driver, still carries the same Ethernet-framed skbs (xmit always pulls
+	// ETH_HLEN), so it saves the neighbour table and nothing else.
+	netkitModeL2 = 0
+	netkitModeL3 = 1
+
+	// ifla_netkit enum values (uapi/linux/if_link.h)
+	netkitAttrScrub     = 6
+	netkitAttrPeerScrub = 7
+	netkitScrubNone     = 1
+
+	// tcDeliveryMTUMin is the default delivery link MTU; larger interface MTUs
+	// raise it. A 65535 device only confuses tools like LuCI.
+	tcDeliveryMTUMin = 1500
+)
+
+// createTCDeliveryPair creates the host/peer pair used to cross into the
+// private listener namespace. The returned link is the host end; the caller
+// re-resolves it by name afterwards.
+// deliveryMTU keeps the pair at a normal Ethernet MTU unless the selected
+// interfaces use larger frames.
+func deliveryMTU(replyMTU int) int {
+	if replyMTU < tcDeliveryMTUMin {
+		return tcDeliveryMTUMin
+	}
+	return replyMTU
+}
+
+func createTCDeliveryPair(kind, hostName, peerName string, hostAddress, peerAddress net.HardwareAddr, namespaceFD, mtu int) (netlink.Link, string, error) {
+	switch kind {
+	case "", DeliveryVeth:
+		link, err := addVethPair(hostName, peerName, hostAddress, peerAddress, namespaceFD, mtu)
+		return link, DeliveryVeth, err
+	case DeliveryNetkit:
+		link, err := addNetkitDelivery(hostName, peerName, hostAddress, peerAddress, namespaceFD, mtu, netkitModeL2)
+		return link, DeliveryNetkit, err
+	case DeliveryNetkitL3:
+		// No MAC, no ARP. The pair still carries Ethernet-framed skbs: the
+		// kernel refuses IFLA_ADDRESS in this mode, so both ends keep the
+		// all-zero address and the delivery path writes zero MACs.
+		link, err := addNetkitDelivery(hostName, peerName, nil, nil, namespaceFD, mtu, netkitModeL3)
+		return link, DeliveryNetkitL3, err
+	case DeliveryAuto:
+		return nil, "", E.New("delivery ", DeliveryAuto, " must be resolved before creating the pair")
+	default:
+		return nil, "", E.New("unknown TC eBPF delivery kind: ", kind)
+	}
+}
+
+func addVethPair(hostName, peerName string, hostAddress, peerAddress net.HardwareAddr, namespaceFD, mtu int) (netlink.Link, error) {
+	veth := &netlink.Veth{
+		LinkAttrs:        netlink.LinkAttrs{Name: hostName, MTU: mtu, HardwareAddr: hostAddress},
+		PeerName:         peerName,
+		PeerHardwareAddr: peerAddress,
+	}
+	if namespaceFD >= 0 {
+		veth.PeerNamespace = netlink.NsFd(namespaceFD)
+	}
+	if err := netlink.LinkAdd(veth); err != nil {
+		return nil, E.Cause(err, "create isolated TC veth (CONFIG_VETH and CAP_NET_ADMIN required)")
+	}
+	return veth, nil
+}
+
+func addNetkitDelivery(hostName, peerName string, hostAddress, peerAddress net.HardwareAddr, namespaceFD, mtu, mode int) (netlink.Link, error) {
+	if err := addNetkitPair(hostName, peerName, hostAddress, peerAddress, namespaceFD, mtu, mode); err != nil {
+		return nil, E.Cause(err, "create isolated TC netkit pair (kernel 6.7+, CONFIG_NETKIT and CAP_NET_ADMIN required)")
+	}
+	link, err := netlink.LinkByName(hostName)
+	if err != nil {
+		return nil, E.Cause(err, "find TC eBPF netkit link")
+	}
+	return link, nil
+}
+
+// createTCDeliveryPairWithNames allocates a name pair for one concrete kind and
+// builds it. The names carry the kind that is actually created, so "auto" has
+// to be resolved into a concrete kind first.
+func createTCDeliveryPairWithNames(kind string, hostAddress, peerAddress net.HardwareAddr, namespaceFD, mtu int) (netlink.Link, string, string, string, error) {
+	hostName, peerName, err := nextTCDeliveryNames(kind)
+	if err != nil {
+		return nil, "", "", "", err
+	}
+	link, actual, err := createTCDeliveryPair(kind, hostName, peerName, hostAddress, peerAddress, namespaceFD, mtu)
+	return link, actual, hostName, peerName, err
+}
+
+// createTCDeliveryPairAuto prefers netkit and falls back to veth when the
+// kernel rejects it. Each attempt names the pair after the kind it creates, so
+// the device is never called something other than what is really mounted.
+func createTCDeliveryPairAuto(hostAddress, peerAddress net.HardwareAddr, namespaceFD, mtu int) (netlink.Link, string, string, string, error) {
+	link, actual, hostName, peerName, netkitErr := createTCDeliveryPairWithNames(DeliveryNetkit, hostAddress, peerAddress, namespaceFD, mtu)
+	if netkitErr == nil {
+		return link, actual, hostName, peerName, nil
+	}
+	link, actual, hostName, peerName, err := createTCDeliveryPairWithNames(DeliveryVeth, hostAddress, peerAddress, namespaceFD, mtu)
+	if err != nil {
+		return nil, "", "", "", E.Errors(err, netkitErr)
+	}
+	return link, actual, hostName, peerName, nil
+}
+
+// ProbeDelivery creates and immediately removes a delivery pair of the given
+// kind in the current network namespace and reports the kind that was actually
+// created. It is the explicit, opt-in mutation used by `tools ebpf status`.
+func ProbeDelivery(kind string) (string, error) {
+	var (
+		link     netlink.Link
+		actual   string
+		hostName string
+		err      error
+	)
+	if kind == DeliveryAuto {
+		link, actual, hostName, _, err = createTCDeliveryPairAuto(nil, nil, -1, deliveryMTU(0))
+	} else {
+		link, actual, hostName, _, err = createTCDeliveryPairWithNames(kind, nil, nil, -1, deliveryMTU(0))
+	}
+	if err == nil && link != nil {
+		_ = netlink.LinkDel(link)
+	}
+	// Deleting one end removes the pair; make sure nothing is left behind.
+	if hostName != "" {
+		if remaining, lookupErr := netlink.LinkByName(hostName); lookupErr == nil {
+			_ = netlink.LinkDel(remaining)
+		}
+	}
+	if err != nil {
+		return "", err
+	}
+	return actual, nil
+}
+
+// addNetkitPair issues RTM_NEWLINK by hand: sagernet/netlink's LinkAdd has a
+// closed set of link types and netkit's nested attributes are not in it.
+func addNetkitPair(hostName, peerName string, hostAddress, peerAddress net.HardwareAddr, namespaceFD, mtu, mode int) error {
+	request := nl.NewNetlinkRequest(unix.RTM_NEWLINK,
+		unix.NLM_F_REQUEST|unix.NLM_F_ACK|unix.NLM_F_CREATE|unix.NLM_F_EXCL)
+	request.AddData(nl.NewIfInfomsg(unix.AF_UNSPEC))
+	request.AddData(nl.NewRtAttr(unix.IFLA_IFNAME, nl.ZeroTerminated(hostName)))
+	request.AddData(nl.NewRtAttr(unix.IFLA_MTU, nl.Uint32Attr(uint32(mtu))))
+	if len(hostAddress) > 0 {
+		request.AddData(nl.NewRtAttr(unix.IFLA_ADDRESS, hostAddress))
+	}
+
+	linkInfo := nl.NewRtAttr(unix.IFLA_LINKINFO, nil)
+	linkInfo.AddRtAttr(nl.IFLA_INFO_KIND, nl.NonZeroTerminated("netkit"))
+	data := linkInfo.AddRtAttr(nl.IFLA_INFO_DATA, nil)
+	data.AddRtAttr(unix.IFLA_NETKIT_MODE, nl.Uint32Attr(uint32(mode)))
+	// scrub=none keeps skb->mark, which bpf_redirect_peer requires to survive
+	// the netkit boundary. Attribute ids follow the kernel's ifla_netkit enum.
+	data.AddRtAttr(netkitAttrScrub, nl.Uint32Attr(netkitScrubNone))
+
+	peer := data.AddRtAttr(unix.IFLA_NETKIT_PEER_INFO, nil)
+	nl.NewIfInfomsgChild(peer, unix.AF_UNSPEC)
+	peer.AddRtAttr(unix.IFLA_IFNAME, nl.ZeroTerminated(peerName))
+	peer.AddRtAttr(unix.IFLA_MTU, nl.Uint32Attr(uint32(mtu)))
+	if len(peerAddress) > 0 {
+		peer.AddRtAttr(unix.IFLA_ADDRESS, peerAddress)
+	}
+	peer.AddRtAttr(netkitAttrPeerScrub, nl.Uint32Attr(netkitScrubNone))
+	if namespaceFD >= 0 {
+		peer.AddRtAttr(unix.IFLA_NET_NS_FD, nl.Uint32Attr(uint32(namespaceFD)))
+	}
+
+	request.AddData(linkInfo)
+
+	if _, err := request.Execute(unix.NETLINK_ROUTE, 0); err != nil {
+		return err
+	}
+	return nil
+}
