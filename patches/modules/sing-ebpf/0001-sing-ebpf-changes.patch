diff --git a/.github/workflows/generate-objects.yml b/.github/workflows/generate-objects.yml
new file mode 100644
index 0000000..0ef39f6
--- /dev/null
+++ b/.github/workflows/generate-objects.yml
@@ -0,0 +1,55 @@
+name: Generate BPF objects
+
+# 在本仓库内重新生成 eBPF 对象（bpfel/bpfeb）。
+# 手动触发 → 产物在 Artifacts 的 bpfgen 里；下载后提交回 internal/bpfgen/。
+#
+# 需要 NDK r29 Clang 21（Makefile 有版本硬校验）。
+
+on:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  generate:
+    name: Generate objects
+    runs-on: ubuntu-26.04
+    timeout-minutes: 40
+    steps:
+      - uses: actions/checkout@v6
+
+      - name: Setup Go
+        uses: actions/setup-go@v6
+        with:
+          go-version-file: go.mod
+          cache: true
+          cache-dependency-path: go.sum
+
+      - name: Setup Android NDK
+        id: setup-ndk
+        uses: nttld/setup-ndk@v1
+        with:
+          ndk-version: r29
+          add-to-path: false
+
+      - name: Generate BPF objects
+        env:
+          ANDROID_NDK_HOME: ${{ steps.setup-ndk.outputs.ndk-path }}
+        run: |
+          set -euo pipefail
+          before=$(sha256sum internal/bpfgen/tc_bpfel.o | cut -d' ' -f1)
+          echo "before: ${before}"
+          make generate
+          after=$(sha256sum internal/bpfgen/tc_bpfel.o | cut -d' ' -f1)
+          echo "after:  ${after}"
+          echo "--- changed:"
+          git status --short -- internal/bpfgen || true
+
+      - name: Upload generated objects
+        uses: actions/upload-artifact@v6
+        with:
+          name: bpfgen
+          path: internal/bpfgen
+          if-no-files-found: error
+          retention-days: 7
