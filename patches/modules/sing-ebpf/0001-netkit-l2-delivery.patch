+// tcxHeadAnchor places the program before the first attached program, so it
+// runs first even when that program carries no priority marker.
+func tcxHeadAnchor(programs []link.AttachedProgram) link.Anchor {
+	for _, attached := range programs {
+		if linkID, linked := attached.LinkID(); linked {
