diff --git a/internal/core/access.go b/internal/core/access.go
index 711519b..d7684a2 100644
--- a/internal/core/access.go
+++ b/internal/core/access.go
@@ -73,6 +73,30 @@ func NewTCBackendHandle(backend *TCBackend) TCBackendHandle {
 	return TCBackendHandle{backend: backend}
 }
 
+// DeliveryKind reports the requested socket-assignment delivery link kind.
+func (h TCBackendHandle) DeliveryKind() string {
+	if h.backend == nil {
+		return ""
+	}
+	return h.backend.delivery
+}
+
+// TCXPosition reports the configured TCX chain end ("head" or "tail").
+func (h TCBackendHandle) TCXPosition() string {
+	if h.backend == nil {
+		return ""
+	}
+	return h.backend.tcxPosition
+}
+
+// TCXPriority reports the configured TCX ordering priority.
+func (h TCBackendHandle) TCXPriority() uint16 {
+	if h.backend == nil {
+		return 0
+	}
+	return h.backend.tcxPriority
+}
+
 func (h TCBackendHandle) tcBackend() *TCBackend {
 	return h.backend
 }
diff --git a/internal/core/diagnostics.go b/internal/core/diagnostics.go
index 8c4079d..ec95418 100644
--- a/internal/core/diagnostics.go
+++ b/internal/core/diagnostics.go
@@ -44,5 +44,7 @@ type TCDiagnostics struct {
 	RetiredAttachmentCount int
 	RetiredDeliveryCount   int
 	Priority               uint16
+	// DeliveryKind is the delivery link actually created ("veth" or "netkit").
+	DeliveryKind           string
 	RequiresRebuild        bool
 }
diff --git a/internal/core/tc.go b/internal/core/tc.go
index 3ec9cae..564003b 100644
--- a/internal/core/tc.go
+++ b/internal/core/tc.go
@@ -101,6 +101,12 @@ type TCConfig struct {
 	EnableTCP          bool
 	EnableUDP          bool
 	DeliveryInterface  uint32
+	Delivery           string
+	// TCXPriority orders TCX programs on the hook; lower runs first.
+	TCXPriority        uint16
+	// TCXPosition picks the chain end when TCXPriority is unset:
+	// "head" runs first, "tail" runs last.
+	TCXPosition        string
 	Policy             CompiledPolicy
 	RoutingMark        uint32
 	SelfBypassMap      *CiliumEBPF.Map
@@ -133,7 +139,7 @@ type tcControl struct {
 	ListenerPort      uint16
 	ReservedPolicy    [2]uint16
 	DeliveryMAC       MACAddress
-	Reserved          uint16
+	DeliveryMode          uint16
 }
 
 type tcAssignKey struct {
@@ -204,6 +210,9 @@ type TCBackend struct {
 	runtime                   *tcRuntime
 	tcpListenerMap            bool
 	programsExposed           bool
+	delivery                  string
+	tcxPriority               uint16
+	tcxPosition               string
 	control                   tcControl
 	controlMapFD              int
 	assignmentMapFD           int
@@ -313,7 +322,12 @@ func prepareTC(config TCConfig, forceLegacyTCP bool) (*TCBackend, error) {
 	if err != nil {
 		return nil, explainBPFPermissionError(err, memlockErr)
 	}
+	deliveryMode := uint16(0)
+	if config.Delivery == "netkit-l3" {
+		deliveryMode = 1
+	}
 	controlValue := tcControl{
+		DeliveryMode: deliveryMode,
 		Flags:             tcFlags(config, policy),
 		DeliveryInterface: config.DeliveryInterface,
 		RoutingMark:       config.RoutingMark,
@@ -350,6 +364,9 @@ func prepareTC(config TCConfig, forceLegacyTCP bool) (*TCBackend, error) {
 		controlMapFD:       maps["tc_control"].FD(),
 		assignmentMapFD:    maps["tc_assignment"].FD(),
 		assignmentCapacity: config.AssignmentCapacity,
+		delivery:           config.Delivery,
+		tcxPriority:        config.TCXPriority,
+		tcxPosition:        config.TCXPosition,
 		selfMapExternal:    config.EnableLocal && config.SelfBypassMap != nil,
 	}
 	// From here, backend owns maps and loadedPrograms: giving up on either of the
@@ -1111,6 +1128,12 @@ func (b *TCBackend) SharedIngressProgram(framing TCLinkFraming) *CiliumEBPF.Prog
 	}
 }
 
+func (b *TCBackend) DeliveryIngressProgram() *CiliumEBPF.Program {
+	return b.program(tcProgramDeliveryIngress)
+}
+func (b *TCBackend) IsolatedReturnProgram() *CiliumEBPF.Program {
+	return b.program(tcProgramIsolatedReturn)
