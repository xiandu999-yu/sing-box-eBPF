+// tcxPriorityOf returns the configured TCX order, falling back to the clsact
+// filter priority when the caller left it unset.
+// tcxAttach attaches through TCX, honoring an explicit chain position when
+// tcx_priority is unset.
+func tcxAttach(interfaceIndex int, attachType CiliumEBPF.AttachType, program *CiliumEBPF.Program, backend *commonEBPF.TCBackend, fallback uint16) (link.Link, error) {
+	priority := tcxPriorityOf(backend, fallback)
+	if backend != nil && backend.TCXPriority() == 0 {
+		switch backend.TCXPosition() {
+		case "head", "tail":
+			return coreAttachTCXPositioned(interfaceIndex, attachType, program, priority, backend.TCXPosition())
+		}
+	}
+	return coreAttachTCXOrdered(interfaceIndex, attachType, program, priority)
+}
+
+func tcxPriorityOf(backend *commonEBPF.TCBackend, fallback uint16) uint16 {
+	if backend != nil {
+		if value := backend.TCXPriority(); value != 0 {
+			return value
+		}
+		switch backend.TCXPosition() {
+		case "tail":
+			return ^uint16(0)
+		case "head":
+			return DefaultTCPriority
+		}
+	}
+	return fallback
+}
