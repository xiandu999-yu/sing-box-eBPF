# 组装 sing-box 源码包时用到的固定点。
# 改动这里之后跑一次 assemble-source 工作流，它会把新 tarball 传到
# sing-box-src release，并把 PKG_SOURCE / PKG_HASH 写回 OpenWrt/sing-box/Makefile。
SING_BOX_REPOSITORY=CHIZI-0618/sing-box
# 2026-11-09 "remove self-bypass mark diagnostics"（收尾 self-bypass 重做）。
# 这一跳含 17 个 commit：UDP generation 隔离、rule-set 策略合并、策略校验、
# diagnostics schema、self-bypass 路径重做。eBPF inbound 仍是
# inboundResources / inboundWorkers / inboundDiagnostics 拆分后的结构。
SING_BOX_COMMIT=91bc15bffb85b52864996f6b4289f79dd9c37a36
# 上游只按 tag / docs/changelog.md 声明版本，源码里 constant.Version 是 "unknown"。
# 91bc15bf 在 v1.15.0-alpha.13 之后，但上游还没 bump，所以版本就是 alpha.13。
SING_BOX_VERSION=1.15.0-alpha.13

# eBPF 数据面模块：上游 commit + patches/modules/sing-ebpf/ 里的补丁。
# 对象不随补丁走，组装时用 NDK r29 现场生成。
MODULE_PATH=github.com/CHIZI-0618/sing-ebpf
MODULE_REPOSITORY=CHIZI-0618/sing-ebpf
# 2026-11-09 "remove socket-mark self-bypass path"（试过 socket mark 后整套回退），
# 另有 cgroup storage / shared 回程、生成物行尾可移植性等修复。
MODULE_COMMIT=e4ac4ff8a75feca01613875bbd31eca4ed5faf10
