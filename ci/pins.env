# 组装 sing-box 源码包时用到的固定点。
# 改动这里之后跑一次 assemble-source 工作流，它会把新 tarball 传到
# sing-box-src release，并把 PKG_SOURCE / PKG_HASH 写回 OpenWrt/sing-box/Makefile。
SING_BOX_REPOSITORY=CHIZI-0618/sing-box
# 2026-11-28：上游合并 Go 1.26/1.27 与一批 proxy 修复后的大版本，含
# "feat(ebpf): add inbound data plane" 与 "docs(ebpf): document inbound and build workflow"。
SING_BOX_COMMIT=b828824f0bd2468bf1777923ae7e824b3a77dc70
# 面向用户的版本号：tarball 文件名、release tag、constant.Version 都用它。
# 上游 docs/changelog.md 顶部已经是 1.15.0-alpha.15。
SING_BOX_VERSION=1.15.0-alpha.15
# OpenWrt / apk 的包版本号：apk 只认 `1.2.3_alpha1`、`1.2.3-r1` 这类语法，
# `1.15.0-alpha.15` 会报 "info field 'version' has invalid value"（ipk 宽松但 apk 严格）。
# 所以写进 Makefile 的 PKG_VERSION 用下划线形式，上游版本号放进 UPSTREAM_VERSION。
SING_BOX_PKG_VERSION=1.15.0_alpha15

# eBPF 数据面模块：上游 commit + patches/modules/sing-ebpf/ 里的补丁。
# 对象不随补丁走，组装时用 NDK r29 现场生成。
MODULE_PATH=github.com/CHIZI-0618/sing-ebpf
MODULE_REPOSITORY=CHIZI-0618/sing-ebpf
# 2026-11-28 "..."：这一跳把 cilium/ebpf 提到
# v0.22.1-0.20261119135504-862b60f0fc93（含 64d4fa2 "parse and split 7.3
# verifier errors"，即 Linux 7.3 的结构化 verifier 报告），同时升到 Go 1.26.11。
# 因此 Linux 7.3.x 上 verifier 报错不再被旧解析逻辑截断。
MODULE_COMMIT=1b82a41143ba050f9f7bf975c564c9714140cce1
