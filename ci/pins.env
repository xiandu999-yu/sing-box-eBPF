# 组装 sing-box 源码包时用到的固定点。
# 改动这里之后跑一次 assemble-source 工作流，它会把新 tarball 传到
# sing-box-src release，并把 PKG_SOURCE / PKG_HASH 写回 OpenWrt/sing-box/Makefile。
SING_BOX_REPOSITORY=CHIZI-0618/sing-box
# 2026-11-09 "update sing-ebpf fallback diagnostics"（self-bypass 收尾三连）。
# 这一跳：self-bypass dial 生命周期、恢复 cgroup 地址旁路、fallback 诊断；
# eBPF inbound 仍是 inboundResources / inboundWorkers / inboundDiagnostics 拆分后的结构。
SING_BOX_COMMIT=949d0cea2debf2ade529d8166ed37c1b208752cf
# 上游只按 tag / docs/changelog.md 声明版本，源码里 constant.Version 是 "unknown"。
# 949d0cea 在 v1.15.0-alpha.13 之后，但上游还没 bump，所以版本就是 alpha.13。
SING_BOX_VERSION=1.15.0-alpha.13

# eBPF 数据面模块：上游 commit + patches/modules/sing-ebpf/ 里的补丁。
# 对象不随补丁走，组装时用 NDK r29 现场生成。
MODULE_PATH=github.com/CHIZI-0618/sing-ebpf
MODULE_REPOSITORY=CHIZI-0618/sing-ebpf
# 2026-11-09 "report self-bypass fallback failures"：回收已关闭的 self-bypass socket、
# 恢复 cookie 清理的 cgroup 地址旁路、新增 FallbackReason() 与 SelfBypassCgroupSocketAddr。
MODULE_COMMIT=bec0ab9440e56fcbfd136212d735803ffef70409
