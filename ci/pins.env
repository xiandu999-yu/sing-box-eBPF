# 组装 sing-box 源码包时用到的固定点。
# 改动这里之后跑一次 assemble-source 工作流，它会把新 tarball 传到
# sing-box-src release，并把 PKG_SOURCE / PKG_HASH 写回 OpenWrt/sing-box/Makefile。
SING_BOX_REPOSITORY=CHIZI-0618/sing-box
# 2026-11-11 "fix(ebpf): roll back self-bypass on box creation failure"。
# 这一跳 3 个 commit / 17 个文件：box 创建失败回滚、跨 box 的重试清理、
# internal/ebpfcleanup 注册表、route/network_ebpf.go。
SING_BOX_COMMIT=e74cfa228dfe3a9d9c80c3d39d1c109608bc1072
# 面向用户的版本号：tarball 文件名、release tag、constant.Version 都用它。
# 上游只按 tag / docs/changelog.md 声明版本，源码里 constant.Version 是 "unknown"。
SING_BOX_VERSION=1.15.0-alpha.13
# OpenWrt / apk 的包版本号：apk 只认 `1.2.3_alpha1`、`1.2.3-r1` 这类语法，
# `1.15.0-alpha.13` 会报 "info field 'version' has invalid value"（ipk 宽松但 apk 严格）。
# 所以写进 Makefile 的 PKG_VERSION 用下划线形式，上游版本号放进 UPSTREAM_VERSION。
SING_BOX_PKG_VERSION=1.15.0_alpha13

# eBPF 数据面模块：上游 commit + patches/modules/sing-ebpf/ 里的补丁。
# 对象不随补丁走，组装时用 NDK r29 现场生成。
MODULE_PATH=github.com/CHIZI-0618/sing-ebpf
MODULE_REPOSITORY=CHIZI-0618/sing-ebpf
# 2026-11-11 "test socket-local storage lifetime"：socket-local 自旁路存储后端、
# direct TGID 自旁路（self_bypass_tgid）、生命周期拆分与可见性诊断。
# 注：e74cfa22 的 go.mod 写的是 02db5a5（更早的模块 commit），d2983dce 是它的后继，
# API 只多不少，所以这里继续固定 d2983dce。
MODULE_COMMIT=d2983dce11d84e0e02c2c5ea95212b74d91aa6d8
